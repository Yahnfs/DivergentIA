# Qual provedor de LLM usar: "ollama" (local, gratuito) ou "claude" (API Anthropic)
LLM_PROVIDER=ollama

# --- Configuração do Ollama (usado quando LLM_PROVIDER=ollama) ---
# Instale o Ollama em https://ollama.com e rode: ollama pull llama3.2:3b
# (o modelo só escreve uma frase curta de abertura; um modelo pequeno de 3B já é suficiente e roda 100% na GPU)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Tempo que o modelo fica carregado na memória após o último uso (evita a demora da 1ª pergunta)
OLLAMA_KEEP_ALIVE=30m

# --- Configuração da Claude API (usado quando LLM_PROVIDER=claude) ---
# Obtenha sua chave em https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Banco de dados (mapeamento colaborativo de locais acessíveis e contas de usuário) ---
DATABASE_URL=sqlite:///./data/locais.db

# --- Contas (login/cadastro/recuperação) ---
# Chave para assinar o cookie de sessão. Gere a sua com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# e troque antes de usar fora do seu computador — com o valor de exemplo abaixo, qualquer pessoa
# que leia este arquivo consegue forjar uma sessão de qualquer conta.
SECRET_KEY=troque-esta-chave-antes-de-usar-fora-do-seu-computador
# True exige HTTPS para o cookie funcionar; deixe False para testar em http://localhost
COOKIE_SECURE=False
# Endereço base usado para montar os links enviados por e-mail (confirmação de conta, redefinir senha)
APP_BASE_URL=http://localhost:8000

# --- Login com Google ("Entrar com Google") ---
# 1. Acesse https://console.cloud.google.com/apis/credentials (crie um projeto, se ainda não tiver um)
# 2. "Criar credenciais" → "ID do cliente OAuth" → tipo "Aplicativo da Web"
# 3. Em "Origens JavaScript autorizadas", adicione http://localhost:8000 (e o endereço real, quando publicar)
# 4. Cole o "ID do cliente" (termina em .apps.googleusercontent.com) abaixo.
# Enquanto estiver vazio, o botão "Entrar com Google" simplesmente não aparece nas telas — nada quebra.
GOOGLE_CLIENT_ID=

# --- Captcha (Google reCAPTCHA v2, gratuito) ---
# Registre o site em https://www.google.com/recaptcha/admin (tipo "reCAPTCHA v2 - Caixa de seleção")
# e use http://localhost:8000 como domínio de teste. Cole as duas chaves que ele gerar.
# Enquanto estiverem vazias, o captcha não aparece e a verificação é pulada no servidor.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- E-mail (confirmação de cadastro e recuperação de senha) ---
# "console" (padrão, grátis): o link aparece no terminal do servidor, ótimo para testar sem configurar nada.
# "smtp": envia de verdade. Com Gmail, ative a verificação em 2 etapas e crie uma "senha de app" em
# https://myaccount.google.com/apppasswords — use-a em SMTP_SENHA (não é a sua senha normal do Gmail).
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=DivergentIA <nao-responda@divergentia.local>

# --- Painel de administração (cadastrar/verificar locais acessíveis) ---
# Usuário e senha fixos, sem relação com as contas de usuário comuns. Entre em /entrar.html
# digitando ADMIN_USUARIO no campo de e-mail e ADMIN_SENHA no campo de senha.
# Troque a senha padrão antes de usar fora do seu computador.
ADMIN_USUARIO=admin
ADMIN_SENHA=UniSales2026
